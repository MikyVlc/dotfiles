; ██╔══██╗██╔═══██╗██║  ╚██╗ ██╔╝██╔══██╗██╔══██╗██╔══██╗
; ██████╔╝██║   ██║██║   ╚████╔╝ ██████╔╝███████║██████╔╝
; ██╔═══╝ ██║   ██║██║    ╚██╔╝  ██╔══██╗██╔══██║██╔══██╗
; ██║     ╚██████╔╝███████╗██║   ██████╔╝██║  ██║██║  ██║
; ╚═╝      ╚═════╝ ╚══════╝╚═╝   ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝
                                                       

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;    ____ ___  _     ___  ____  ____  
;   / ___/ _ \| |   / _ \|  _ \/ ___| 
;  | |  | | | | |  | | | | |_) \___ \ 
;  | |__| |_| | |__| |_| |  _ < ___) |
;   \____\___/|_____\___/|_| \_\____/                                     
[colors]
; Wildberries theme
background = #aa19002e
foreground = #c79bff
foreground-alt = #03a5c9

primary = #ff0e82
secondary = #00ffb7
alert = #f40056

cyan = #00ffdb
aqua = #00f7e2
red = #d70040
yellow = #ffd700
green = #00ffb7
orange = #ff4500
magenta = #e0a9ff
;white = #ff2b99
white = #88c0d0
pink = #900048
blue = #399ee6
black = #240041
bright-black = #2e3440

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[bar/example]
width = 100%
height = 20
radius = 0.0
fixed-center = true

background = ${colors.background}
foreground = ${colors.foreground}

padding-left = 0
padding-right = 0

border-size = 8
border-color = ${colors.background} 

module-margin-left = 0
module-margin-right = 0

font-0 = "Inconsolata CondensedBlack:size=13;3"
font-1 = "SauceCodePro Nerd Font Mono:size=22;6"
font-2 = "Material Icons:pixelsize=15;5"
font-3 = "Sinji:pixelsize=15;5"
font-4 = "Togalite medium:pixelsize=11;2"

; MODULES SETUP
modules-left = launcher kernel-name left1 tray left2 left3 bspwm left4
modules-center = medium1 windowtitle medium2 sep
modules-right = right1 filesystem cpu memory volume network date right2 shutdown

;tray-position = right
;tray-padding = 5
;tray-background = #0063ff

cursor-click = pointer
cursor-scroll = pointer

line-size = 2

;separator = %{F#4C566A}|%{F-}

[module/left1]
type = custom/text
content-foreground = ${colors.black}
content = " "

[module/left2]
type = custom/text
content-foreground = ${colors.black}
content = ""

[module/left3]
type = custom/text
content-foreground = ${colors.pink}
content = "  "

[module/left4]
type = custom/text
content-foreground = ${colors.pink}
content = ""

[module/medium1]
type = custom/text
content-foreground = ${colors.black}
content = " "

[module/medium2]
type = custom/text
content-foreground = ${colors.black}
content = ""

[module/right1]
type = custom/text
content-foreground = ${colors.black}
content = " "

[module/right2]
type = custom/text
content-foreground = ${colors.black}
content = ""

[module/sep]
type = custom/text
content = " "

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/bspwm]
type = internal/bspwm
;ws-icon-0 = I;%{F#A3BE8C}
;ws-icon-1 = II;%{F#D08770}
;ws-icon-2 = III;%{F#81A1C1}󰨞
;ws-icon-3 = IV;%{F#88C0D0}
;ws-icon-4 = V;%{F#D08770}
;ws-icon-5 = VI;%{F#A3BE8C}
;ws-icon-default = ♟

; BSPWM workspace colors and customization
;label-focused = "%icon%"
label-focused = %name%
label-focused-background = ${colors.pink}
;label-focused-underline = ${colors.aqua}
label-focused-foreground = ${colors.green}
label-focused-padding = 2

;label-occupied = %icon%
label-occupied = %name%
label-occupied-background = ${colors.black}
label-occupied-foreground = ${colors.magenta}
label-occupied-padding = 2

;label-urgent = %icon%
label-urgent = %name%
label-urgent-background = ${colors.background}
label-urgent-foreground = ${colors.orange}
label-urgent-padding = 2

;label-empty = %icon%
label-empty = %name%
label-empty-background = ${colors.background}
label-empty-foreground = ${colors.bright-black}
label-empty-padding = 2

; Separator in between workspaces 03a5c9
label-separator = %{F#900048}║

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/launcher]
type = custom/script
exec = echo 
;exec = echo 
interval = 100

label = "  %output%  "
;format-background = ${colors.white}
format-foreground = ${colors.blue}

click-left = dmenu_run -p " dmenu run" -i -fn "Inconsolata CondensedBlack-21" -nb '#240041' -nf '#c79bff' -sf '#00ffb7' -sb '#900048'

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/kernel-name]
type = custom/script
exec = uname -r
interval = 10000

;label = "  󰌽  %output% "
label = "%output% "
format-foreground = ${colors.white}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/tray]
type = internal/tray

format-background = ${colors.black}
; Espaciado entre iconos
tray-spacing = 13px
; Padding alrededor de cada icono
tray-padding = 3px
; Tamaño de los iconos (relativo a la altura de la barra)
tray-size = 100%
tray-background = ${colors.black}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/filesystem]
type = internal/fs

; Mountpoints to display
mount-0 = /

; Seconds to sleep between updates
; Default: 30
interval = 10

; Display fixed precision values
; Default: false
fixed-values = true

; Spacing between entries
; Default: 2
spacing = 4

; Available tags:
;   <label-mounted> (default)
;   <bar-free>
;   <bar-used>
;   <ramp-capacity>
format-mounted = <label-mounted>

; Available tags:
;   <label-unmounted> (default)
format-unmounted = <label-unmounted>

; Available tokens:
;   %mountpoint%
;   %type%
;   %fsname%
;   %percentage_free%
;   %percentage_used%
;   %total%
;   %free%
;   %used%
; Default: %mountpoint% %percentage_free%%
label-mounted = "    %percentage_used%% "

; Available tokens:
;   %mountpoint%
; Default: %mountpoint% is not mounted
label-unmounted = %mountpoint%: not mounted
label-unmounted-foreground = #55
label-unmounted-background = ${colors.black}
label-mounted-background = ${colors.black}
label-mounted-foreground = ${colors.blue}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/windowtitle]
type = internal/xwindow

format = <label>
format-background = ${colors.black}
format-foreground = ${colors.cyan}
format-padding = 1

label = "  %title%"
label-maxlen = 30
label-empty = "  "
label-separator = " "
label-empty-foreground = ${colors.aqua}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/volume]
type = internal/pulseaudio

format-volume =  "<ramp-volume> <label-volume>"
ramp-volume-0 ="   "
ramp-volume-0-font = 1
ramp-volume-1 ="   "
ramp-volume-1-font = 1
ramp-volume-2 ="   "
ramp-volume-2-font = 1
format-volume-background = ${colors.black}
format-volume-foreground = ${colors.cyan}
format-volume-padding = 1

format-muted = <label-muted>
format-muted-background = ${colors.black}	
format-muted-foreground = ${colors.alert}
format-muted-font = 2
label-muted ="   "

click-right = pavucontrol

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/memory]
type = internal/memory
; Seconds to sleep between updates
interval = 3

format-prefix-padding = 2
format-prefix-font = 2
format-prefix-foreground = #ffffff
format-background = ${colors.black}
format-foreground = ${colors.primary}

label = "    %percentage_used%%"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/network]
type = internal/network
interface = eno1
interval = 3.0

udspeed-minwidth = 5

accumulate-stats = true
unknown-as-up = true

format-connected = <label-connected>
format-disconnected = <label-disconnected>

label-connected = "   󰈀%downspeed% "
label-connected-foreground = ${colors.green}
label-connected-background = ${colors.black}

label-disconnected = "   󰈂 "
label-disconnected-foreground = ${colors.orange}
label-disconnected-background = ${colors.black}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/cpu]
type = internal/cpu
interval = 1

format = <label>
format-background = ${colors.black}
format-foreground = ${colors.yellow}

label = "    %percentage%% "

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/date]
type = internal/date
interval = 1

date = 
date-alt = "   󰔠  %A, %b %d -"

time = "    %H:%M "
time-alt = "%H:%M:%S "

;format-prefix = ""
format-prefix-padding = 1
format-prefix-font = 1
format-prefix-foreground = #ffffff
format-background = ${colors.black}
format-foreground = ${colors.magenta}

label = %date% %time%

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/shutdown]
type = custom/text

content = " "
;content-background = ${colors.black}
content-foreground = ${colors.red}
content-padding = 1

click-left = $HOME/.config/power-menu.sh 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[settings]
screenchange-reload = true
;compositing-background = xor
;compositing-background = screen
;compositing-foreground = source
;compositing-border = over
pseudo-transparency = true

[global/wm]
;margin-top = 5
;margin-bottom = 5

;vim:ft=dosini
