; ██████╗  ██████╗ ██╗  ██╗   ██╗██████╗  █████╗ ██████╗ 
; ██╔══██╗██╔═══██╗██║  ╚██╗ ██╔╝██╔══██╗██╔══██╗██╔══██╗
; ██████╔╝██║   ██║██║   ╚████╔╝ ██████╔╝███████║██████╔╝
; ██╔═══╝ ██║   ██║██║    ╚██╔╝  ██╔══██╗██╔══██║██╔══██╗
; ██║     ╚██████╔╝███████╗██║   ██████╔╝██║  ██║██║  ██║
; ╚═╝      ╚═════╝ ╚══════╝╚═╝   ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝
                                                       

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;    ____ ___  _     ___  ____  ____  
;   / ___/ _ \| |   / _ \|  _ \/ ___| 
;  | |  | | | | |  | | | | |_) \___ \ 
;  | |__| |_| | |__| |_| |  _ < ___) |
;   \____\___/|_____\___/|_| \_\____/                                     
[colors]
; Dracula theme
background = #bb282a36
background-alt = #44475a
foreground = #f8f8f2
foreground-alt = #6272a4
primary = #bd93f9
secondary = #ffb86c
alert = #ff5555
disabled = #6272a4

orange = #ff4500
white = #bb88c0d0
blue = #399ee6

aqua = #8be9fd
red = #ff5555
yellow = #f1fa8c
green = #50fa7b
magenta = #ff79c6
;white = #ffffff
pink = #ff79c6
black = #282a36
bright-black = #2e3440

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[bar/example]
monitor = DisplayPort-0

width = 100%
height = 20
radius = 0.0
fixed-center = true

background = ${colors.background}
foreground = ${colors.foreground}

padding-left = 0
padding-right = 0

border-size = 8
border-color = ${colors.background} 

module-margin-left = 0
module-margin-right = 0

font-0 = "Inconsolata CondensedBlack:size=13;3"
font-1 = "SauceCodePro Nerd Font Mono:size=22;6"
font-2 = "Material Icons:pixelsize=15;5"
font-3 = "Sinji:pixelsize=15;5"
font-4 = "Togalite medium:pixelsize=11;2"

; MODULES SETUP
modules-left = launcher kernel-name left1 tray left2 left3 bspwm left4
modules-center = medium1 windowtitle medium2 sep
modules-right = right1 filesystem cpu memory volume network date right2 shutdown

;tray-position = right
;tray-padding = 5
;tray-background = #0063ff

cursor-click = pointer
cursor-scroll = pointer

line-size = 2

;separator = %{F#4C566A}|%{F-}

[module/left1]
type = custom/text
content-foreground = ${colors.background-alt}
content = " "

[module/left2]
type = custom/text
content-foreground = ${colors.background-alt}
content = ""

[module/left3]
type = custom/text
content-foreground = ${colors.background-alt}
content = "  ║"

[module/left4]
type = custom/text
content-foreground = ${colors.background-alt}
content = "║"

[module/medium1]
type = custom/text
content-foreground = ${colors.background-alt}
content = " "

[module/medium2]
type = custom/text
content-foreground = ${colors.background-alt}
content = ""

[module/right1]
type = custom/text
content-foreground = ${colors.background-alt}
content = " "

[module/right2]
type = custom/text
content-foreground = ${colors.background-alt}
content = ""

[module/sep]
type = custom/text
content = " "

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/bspwm]
type = internal/bspwm
ws-icon-0 = I;
ws-icon-1 = II;
ws-icon-2 = III;
ws-icon-3 = IV;
ws-icon-4 = V;
ws-icon-5 = VI;

ws-icon-default = ♟

; BSPWM workspace colors and customization
label-focused = "%icon%"
;label-focused = %name%
label-focused-background = ${colors.background-alt}
;label-focused-underline = ${colors.aqua}
label-focused-foreground = ${colors.foreground}
label-focused-padding = 2

label-occupied = %icon%
;label-occupied = %name%
label-occupied-background = ${colors.background}
label-occupied-foreground = ${colors.disabled}
label-occupied-padding = 2

label-urgent = %icon%
;label-urgent = %name%
label-urgent-background = ${colors.background}
label-urgent-foreground = ${colors.orange}
label-urgent-padding = 2

label-empty = %icon%
;label-empty = %name%
label-empty-background = ${colors.background}
label-empty-foreground = ${colors.bright-black}
label-empty-padding = 2

; Separator in between workspaces (bright-blue=03a5c9)
label-separator = %{F#44475a}║

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/launcher]
type = custom/script
exec = echo 
;exec = echo 
interval = 100

label = "  %output%  "
;format-background = ${colors.white}
format-foreground = ${colors.blue}

click-left = dmenu_run -p " dmenu run" -i -fn "Inconsolata CondensedBlack-21" -nb '#240041' -nf '#c79bff' -sf '#00ffb7' -sb '#900048'

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/kernel-name]
type = custom/script
exec = uname -r
interval = 10000

;label = "  󰌽  %output% "
label = "%output% "
format-foreground = ${colors.white}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/tray]
type = internal/tray

format-background = ${colors.background-alt}
; Espaciado entre iconos
tray-spacing = 13px
; Padding alrededor de cada icono
tray-padding = 3px
; Tamaño de los iconos (relativo a la altura de la barra)
tray-size = 80%
tray-background = ${colors.background-alt}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/filesystem]
type = internal/fs

; Mountpoints to display
mount-0 = /

; Seconds to sleep between updates
; Default: 30
interval = 10

; Display fixed precision values
; Default: false
fixed-values = true

; Spacing between entries
; Default: 2
spacing = 4

; Available tags:
;   <label-mounted> (default)
;   <bar-free>
;   <bar-used>
;   <ramp-capacity>
format-mounted = <label-mounted>

; Available tags:
;   <label-unmounted> (default)
format-unmounted = <label-unmounted>

; Available tokens:
;   %mountpoint%
;   %type%
;   %fsname%
;   %percentage_free%
;   %percentage_used%
;   %total%
;   %free%
;   %used%
; Default: %mountpoint% %percentage_free%%
label-mounted = "    %percentage_used%% "

; Available tokens:
;   %mountpoint%
; Default: %mountpoint% is not mounted
label-unmounted = %mountpoint%: not mounted
label-unmounted-foreground = #55
label-unmounted-background = ${colors.background-alt}
label-mounted-background = ${colors.background-alt}
label-mounted-foreground = ${colors.yellow}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/windowtitle]
type = internal/xwindow

format = <label>
format-background = ${colors.background-alt}
format-foreground = ${colors.foreground}
format-padding = 1

label = "  %title%"
label-maxlen = 30
label-empty = "  "
label-separator = " "
label-empty-foreground = ${colors.foreground-alt}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/volume]
type = internal/pulseaudio

format-volume =  "<ramp-volume> <label-volume>"
ramp-volume-0 ="   "
ramp-volume-0-font = 1
ramp-volume-1 ="   "
ramp-volume-1-font = 1
ramp-volume-2 ="   "
ramp-volume-2-font = 1
format-volume-background = ${colors.background-alt}
format-volume-foreground = ${colors.secondary}
format-volume-padding = 1

format-muted = <label-muted>
format-muted-background = ${colors.background-alt}
format-muted-foreground = ${colors.orange}
format-muted-font = 2
label-muted ="   "

click-right = pavucontrol

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/memory]
type = internal/memory
; Seconds to sleep between updates
interval = 3

format-prefix-padding = 2
format-prefix-font = 2
format-prefix-foreground = #ffffff
format-background = ${colors.background-alt}
format-foreground = ${colors.green}

label = "    %percentage_used%%"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/network]
type = internal/network
interface = wlan0
format-connected = <label-connected>
format-connected-prefix = " "
format-connected-prefix-font = 2
;label-connected = " %essid%%downspeed:9% "
label-connected = %{A1:nm-connection-editor:} %essid%%downspeed:9%%{A}
label-connected-font = 1

format-disconnected = <label-disconnected>
format-disconnected-prefix = "  "
;label-disconnected = 
label-disconnected = %{A1:nm-connection-editor:}%{A}
label-disconnected-font = 2

format-connected-background = ${colors.background-alt}
format-connected-foreground = ${colors.primary}
format-disconnected-background = ${colors.background-alt}
format-disconnected-foreground = ${colors.alert}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/wired-network]
type = internal/network
interface = eno1
interval = 3.0

udspeed-minwidth = 5

accumulate-stats = true
unknown-as-up = true

format-connected = <label-connected>
format-disconnected = <label-disconnected>

label-connected = "   󰈀%downspeed% "
label-connected-foreground = ${colors.foreground}
label-connected-background = ${colors.background-alt}

label-disconnected = "   󰈂 "
label-disconnected-foreground = ${colors.alert}
label-disconnected-background = ${colors.background-alt}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/cpu]
type = internal/cpu
interval = 1

format = <label>
format-background = ${colors.background-alt}
format-foreground = ${colors.magenta}

label = "    %percentage%% "

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/date]
type = internal/date
interval = 1

date = 
date-alt = "   󰔠 %A, %b %d -"

time = "   %H:%M "
time-alt = "%H:%M:%S "

;format-prefix = ""
format-prefix-padding = 1
format-prefix-font = 1
format-prefix-foreground = #ffffff
format-background = ${colors.background-alt}
format-foreground = ${colors.aqua}

label = %date% %time%

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[module/shutdown]
type = custom/text

content = " "
;content-background = ${colors.black}
content-foreground = ${colors.red}
content-padding = 1

click-left = $HOME/.config/power-menu.sh 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[settings]
screenchange-reload = true
;compositing-background = xor
;compositing-background = screen
;compositing-foreground = source
;compositing-border = over
pseudo-transparency = true

[global/wm]
;margin-top = 5
;margin-bottom = 5

;vim:ft=dosini

[bar/example2]
monitor = HDMI-A-0

width = 100%
height = 20
radius = 0.0
fixed-center = true

background = ${colors.background}
foreground = ${colors.foreground}

padding-left = 0
padding-right = 0

border-size = 8
border-color = ${colors.background}

module-margin-left = 0
module-margin-right = 0

font-0 = "Inconsolata CondensedBlack:size=13;3"
font-1 = "SauceCodePro Nerd Font Mono:size=22;6"
font-2 = "Material Icons:pixelsize=15;5"
font-3 = "Sinji:pixelsize=15;5"
font-4 = "Togalite medium:pixelsize=11;2"

; MODULES SETUP
modules-left = launcher kernel-name left3 bspwm left4
modules-center = medium1 windowtitle medium2 sep
modules-right = right1 filesystem cpu memory volume wired-network date right2 shutdown

;tray-position = right
;tray-padding = 5
;tray-background = #0063ff

cursor-click = pointer
cursor-scroll = pointer

line-size = 2

;separator = %{F#4C566A}|%{F-}
